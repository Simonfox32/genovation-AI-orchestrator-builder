# Copy this file to .env and fill in your own values. Never commit .env.
#
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Local Homebrew Postgres usually needs no password: postgresql+psycopg://YOUR_MAC_USERNAME@localhost:5432/ai_build_router
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_build_router

# Separate database used only by pytest. Tests delete its data.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ai_build_router_test

# Comma-separated frontend origins allowed to call this API from a browser (CORS).
# Defaults to the local Vite dev server if unset. Add the Vercel URL when deployed.
CORS_ORIGINS=http://localhost:5173

# Secret required in the X-API-Key header for PATCH /projects/{id}/status.
# If unset, every status update is rejected. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_API_KEY=change-me

# Maximum projects one client (IP address) can create per minute; more returns 429. Default 10.
RATE_LIMIT_PER_MINUTE=10

# Gemini API key for the real AI tools. Get your own free key at aistudio.google.com; never commit it.
GEMINI_API_KEY=

# "real" makes the router call Gemini to write code; anything else (or unset) uses the fake stub tools.
# Leave unset on public deployments until generated code runs in an isolated process (Sprint 5 #124).
ROUTER_TOOLS=
